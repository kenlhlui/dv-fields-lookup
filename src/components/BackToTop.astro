<a
	href="#top"
	aria-label="Back to top"
	class="back-to-top fixed right-4 bottom-4 z-50 rounded-full border border-border bg-background p-2 text-muted-foreground opacity-0 shadow transition-opacity duration-200 pointer-events-none hover:text-foreground data-[visible]:opacity-100 data-[visible]:pointer-events-auto"
>
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
		<path d="M12 19V5M5 12l7-7 7 7" />
	</svg>
</a>

<script is:inline>
	// ponytail: plain scroll listener, no IntersectionObserver needed for a single fixed threshold
	document.addEventListener('scroll', () => {
		document.querySelector('.back-to-top')?.toggleAttribute('data-visible', window.scrollY > 400);
	}, { passive: true });
</script>

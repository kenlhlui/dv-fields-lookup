---
import { marked } from 'marked';

import InformationDialog from '@/components/InformationDialog';
import MetadataDictionary from '@/components/dictionary/MetadataDictionary';
import ThemeToggle from '@/components/ThemeToggle';
import Footer from '@/components/Footer.astro';
import { blockDescriptions } from '@/data/block-descriptions';
import metadataJson from '@/data/metadata.json';
import { metadataOverrides } from '@/data/metadata.overrides';
import Layout from '@/layouts/Layout.astro';
import { buildMetadata } from '@/lib/metadata';
import { site } from '@/site.config';
import { compiledContent } from '@/content/information.md';

// bestPracticeDefinition is hand-authored markdown; render it to HTML here (build time,
// same as information.md below) so the client never ships a markdown parser.
const metadata = buildMetadata(metadataJson, metadataOverrides, blockDescriptions).map((block) => ({
  ...block,
  fields: block.fields.map((field) =>
    field.bestPracticeDefinition
      ? { ...field, bestPracticeDefinitionHtml: marked.parse(field.bestPracticeDefinition, { async: false }) }
      : field,
  ),
}));
const InformationHtml = await compiledContent();
// ponytail: defaults for installations that don't set their own name/URL
const dataverseName = site.dataverseName || 'The Dataverse Project';
const dataverseURL = site.dataverseURL || 'https://dataverse.org/';
---

<Layout title={site.title} description={site.description}>
	<main class="mx-auto min-h-screen w-full max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
		<header class="mb-10 flex items-center justify-between gap-4">
			<div class="max-w-3xl">
				<p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-primary">
					<a href={dataverseURL} target="_blank" rel="noopener noreferrer">{dataverseName}</a>
				</p>
				<h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{site.title}</h1>
				<p class="mt-4 text-lg leading-8 text-muted-foreground">{site.description}</p>
			</div>
			<div class="flex items-center gap-1">
				<InformationDialog html={InformationHtml} client:load />
				<ThemeToggle client:load />
			</div>
		</header>
		<MetadataDictionary blocks={metadata} client:load />
	</main>
	<Footer githubUrl={site.githubUrl}>
		<p class="whitespace-pre-line">{site.footerText}</p>
	</Footer>
</Layout>
